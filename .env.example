# Beehiiv Newsletter Configuration
BEEHIV_PUBLICATION_ID=your_publication_id_here
BEEHIV_API_KEY=your_api_key_here

# Supabase (server-only service role — never expose to the client)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=

# Segredo compartilhado com o cron do Vercel para autorizar POST /api/opportunities/refresh
CRON_SECRET=

# --- RAG / Accessia (scripts/*, server/api/rag/*, server/utils/rag/*) ---
# Projeto Supabase de DEV (isolado do prod, usado por scripts de sync/embed/eval)
DEV_SUPABASE_URL=
DEV_SUPABASE_SERVICE_ROLE_KEY=

# Projeto Supabase de PRODUÇÃO (usado só pelo script de sync, leitura)
PROD_SUPABASE_URL=
PROD_SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA NIM (embeddings, rerank e geração via chat completions)
NVIDIA_API_KEY=
EMBEDDING_MODEL=llama-nemotron-embed-1b-v2
EMBEDDING_DIMENSIONS=1024
